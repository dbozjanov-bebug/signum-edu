# Example Environment Variables for Server

# STT Providers
STT_PROVIDER_1_API_KEY=<your_api_key_here>
STT_PROVIDER_2_API_KEY=<your_api_key_here>

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=<your_db_user>
DB_PASSWORD=<your_db_password>
DB_NAME=<your_db_name>

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>